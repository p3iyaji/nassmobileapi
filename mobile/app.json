{
  "expo": {
    "name": "NALTF mobile",
    "slug": "naltf-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/naltf-logo.png",
    "scheme": "naltfmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/naltf-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf7f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naltf.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/naltf-logo.png",
        "backgroundColor": "#faf7f2"
      },
      "package": "com.naltf.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
